Wine 11.18: implement IMFMediaEngine.Load using the existing eager source
resolution, retaining shutdown errors. CommonDX calls Source, Load, then Play;
the old E_NOTIMPL prevented Play from being reached. Reset the per-source
waiting gate when selecting a replacement, so menu-to-level music can start.

--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -1733,0 +1734,4 @@
+    /* Waiting belongs to the old source. A new Play must queue playback for
+     * this source, even when the previous track was already playing. */
+    media_engine_set_flag(engine, FLAGS_ENGINE_WAITING, FALSE);
+
@@ -1875,3 +1879,4 @@
-    HRESULT hr = E_NOTIMPL;
-
-    FIXME("(%p): stub.\n", iface);
+    HRESULT hr = S_OK;
+    BSTR source;
+
+    TRACE("%p.\n", iface);
@@ -1882,0 +1888,9 @@
+    /* SetSource already starts resolution. Continue that request instead of
+     * starting a second concurrent load; for a resolved URL, reload it using
+     * the same source-selection path. Copy it before set_source frees it. */
+    else if (!(engine->flags & FLAGS_ENGINE_SOURCE_PENDING) && engine->current_source)
+    {
+        source = SysAllocString(engine->current_source);
+        hr = source ? media_engine_set_source(engine, NULL, source) : E_OUTOFMEMORY;
+        SysFreeString(source);
+    }

--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -2181,0 +2182,4 @@
+        /* The replacement has not started. Retaining STARTED makes a
+         * following Start(VT_EMPTY) return without starting its sources. */
+        IMFPresentationClock_Stop(session->clock);
+        session->state = SESSION_STATE_STOPPED;
